       const composedValue = variantId(selectedValue, npuConfig.dp, npuConfig.pp);
       const finalValue = composedValue !== selectedValue && getDiscoveredModelIds().includes(composedValue) ? composedValue : selectedValue;
+      // 고르는 즉시 로딩을 시작시킨다. 라우터는 lazy 라 이게 없으면 첫 메시지를
+      // 보낼 때까지 아무 일도 안 일어난 것처럼 보인다.
+      preloadNpuModel(finalValue);
