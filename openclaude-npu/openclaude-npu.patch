+import { describe, expect, test } from 'bun:test'
+import { type NpuModel, npuDisplayModels, parseStatus, routerBaseUrl } from './npuStatus.js'
+
+const model = (id: string, state: NpuModel['state'] = 'up'): NpuModel => ({
+  id,
+  state,
+  cards: [],
+  dp: 1,
+  pp: 1,
+})
+
+describe('routerBaseUrl', () => {
+  test('strips the /v1 suffix so router endpoints resolve', () => {
+    expect(routerBaseUrl({ OPENAI_BASE_URL: 'http://127.0.0.1:8400/v1' })).toBe(
+      'http://127.0.0.1:8400',
+    )
+  })
+
+  test('is null when no OpenAI-compatible backend is configured', () => {
+    expect(routerBaseUrl({})).toBeNull()
+  })
+})
+
+describe('parseStatus', () => {
+  test('treats an unknown server state as up rather than hiding the model', () => {
+    const { models } = parseStatus({ running: { 'A': { state: 'wat', cards: [0] } } })
+    expect(models[0]?.state).toBe('up')
+  })
+
+  test('sorts by id so the status line does not reshuffle between polls', () => {
+    const { models } = parseStatus({ running: { B: {}, A: {}, C: {} } })
+    expect(models.map(m => m.id)).toEqual(['A', 'B', 'C'])
+  })
+})
+
+describe('npuDisplayModels', () => {
+  test('puts the selected model first', () => {
+    const out = npuDisplayModels([model('A'), model('B'), model('C')], 'B')
+    expect(out.map(m => m.id)).toEqual(['B', 'A', 'C'])
+  })
+
+  test('includes a selected model the router has never heard of, as down', () => {
+    const out = npuDisplayModels([model('A')], 'Cold')
+    expect(out.map(m => m.id)).toEqual(['Cold', 'A'])
+    expect(out[0]?.state).toBe('down')
+  })
+
+  test('lists everything when nothing is selected', () => {
+    expect(npuDisplayModels([model('A'), model('B')], null).map(m => m.id)).toEqual(['A', 'B'])
+  })
+
+  test('does not duplicate the selected model', () => {
+    const out = npuDisplayModels([model('A'), model('B')], 'A')
+    expect(out.filter(m => m.id === 'A')).toHaveLength(1)
+  })
+})
