+import { PassThrough } from 'node:stream'
+import { stripVTControlCharacters as stripAnsi } from 'node:util'
+
+import { expect, test } from 'bun:test'
+import React from 'react'
+
+import { render } from '../ink.js'
+import { KeybindingSetup } from '../keybindings/KeybindingProviderSetup.js'
+import { AppStateProvider, getDefaultAppState } from '../state/AppState.js'
+import type { SurveyQuestion } from '../utils/survey.js'
+import { SURVEY_QUESTIONS } from '../utils/survey.js'
+import { SurveyForm } from './SurveyForm.js'
+
+const DOWN = '\u001B[B'
+const UP = '\u001B[A'
+const ENTER = '\r'
+const ESC = '\u001B'
+
+const TWO_QUESTIONS: SurveyQuestion[] = [
+  {
+    id: 'service',
+    prompt: '평소 어떤 AI 서비스를 쓰십니까?',
+    choices: [
+      { value: 'chatgpt', label: 'ChatGPT' },
+      { value: 'claude', label: 'Claude' },
+      { value: 'gemini', label: 'Gemini' },
+    ],
+  },
+  {
+    id: 'satisfaction',
+    prompt: '전반적으로 얼마나 만족하셨습니까?',
+    choices: [
+      { value: 'low', label: '불만족' },
+      { value: 'mid', label: '보통' },
+      { value: 'high', label: '만족' },
+    ],
+    defaultValue: 'mid',
+  },
+]
+
+type Harness = {
+  output: () => string
+  type: (keys: string) => Promise<void>
+  waitFor: (text: string) => Promise<void>
+  stop: () => void
+}
+
+async function mount(
+  element: React.ReactElement,
+  columns = 100,
+): Promise<Harness> {
+  let output = ''
+  const stdout = new PassThrough()
+  const stdin = new PassThrough() as PassThrough & {
+    isTTY: boolean
+    setRawMode: (mode: boolean) => void
+    ref: () => void
+    unref: () => void
+  }
+  stdin.isTTY = true
+  stdin.setRawMode = () => {}
+  stdin.ref = () => {}
+  stdin.unref = () => {}
+  ;(stdout as unknown as { columns: number }).columns = columns
+  stdout.on('data', chunk => {
+    output += chunk.toString()
+  })
+
+  // Arrow keys / Enter / Esc reach Select through the keybinding system, which
+  // needs the same providers the app mounts a picker inside.
+  const instance = await render(
+    <AppStateProvider initialState={getDefaultAppState()}>
+      <KeybindingSetup>{element}</KeybindingSetup>
+    </AppStateProvider>,
+    {
+      stdin: stdin as unknown as NodeJS.ReadStream,
+      stdout: stdout as unknown as NodeJS.WriteStream,
+      exitOnCtrlC: false,
+    },
+  )
+
+  const waitFor = async (text: string): Promise<void> => {
+    const startedAt = Date.now()
+    while (Date.now() - startedAt < 2000) {
+      if (stripAnsi(output).includes(text)) return
+      await Bun.sleep(10)
+    }
+    throw new Error(`Timed out waiting for ${JSON.stringify(text)}`)
+  }
+
+  return {
+    output: () => stripAnsi(output),
+    // Frames accumulate, so a keypress clears the buffer first: what follows
+    // is only what was drawn *after* that key — otherwise an earlier screen
+    // still matches and a failed transition reads as a pass.
+    //
+    // A lone Escape byte could be the start of a sequence, so the parser holds
+    // it for NORMAL_TIMEOUT (300ms) before deciding it was the key itself.
+    // Anything else lands immediately.
+    type: async (keys: string) => {
+      output = ''
+      stdin.write(keys)
+      await Bun.sleep(keys === ESC ? 400 : 30)
+    },
+    waitFor,
+    stop: () => {
+      instance.unmount()
+      stdin.end()
+      stdout.end()
+    },
+  }
+}
+
+test('moves through the options with the arrow keys and answers on Enter', async () => {
+  const answers: Record<string, string>[] = []
+  const h = await mount(
+    <SurveyForm
+      questions={TWO_QUESTIONS}
+      onSubmit={a => answers.push(a)}
+      onCancel={() => {}}
+    />,
+  )
+
+  try {
+    await h.waitFor('평소 어떤 AI 서비스를 쓰십니까?')
+    expect(h.output()).toContain('1/2')
+
+    // Down twice lands on the third option; Enter answers with it.
+    await h.type(DOWN)
+    await h.type(DOWN)
+    await h.type(ENTER)
+
+    await h.waitFor('전반적으로 얼마나 만족하셨습니까?')
+    expect(h.output()).toContain('2/2')
+    // The first answer is echoed as the comparison anchor for what follows.
+    expect(h.output()).toContain('비교 대상: Gemini')
+
+    // This question starts on '보통'; one step up is '불만족'.
+    await h.type(UP)
+    await h.type(ENTER)
+
+    expect(answers).toEqual([{ service: 'gemini', satisfaction: 'low' }])
+  } finally {
+    h.stop()
+  }
+})
+
+test('Esc steps back, and leaves from the first question', async () => {
+  let cancelled = 0
+  const h = await mount(
+    <SurveyForm
+      questions={TWO_QUESTIONS}
+      onSubmit={() => {}}
+      onCancel={() => {
+        cancelled++
+      }}
+    />,
+  )
+
+  try {
+    await h.waitFor('평소 어떤 AI 서비스를 쓰십니까?')
+    await h.type(ENTER)
+    await h.waitFor('전반적으로 얼마나 만족하셨습니까?')
+
+    // A wrong keypress must not cost the whole form.
+    await h.type(ESC)
+    await h.waitFor('평소 어떤 AI 서비스를 쓰십니까?')
+    expect(cancelled).toBe(0)
+
+    // Esc again, with nowhere to step back to, closes the form.
+    await h.type(ESC)
+    expect(cancelled).toBe(1)
+  } finally {
+    h.stop()
+  }
+})
+
+test('an answer can be changed after stepping back', async () => {
+  const answers: Record<string, string>[] = []
+  const h = await mount(
+    <SurveyForm
+      questions={TWO_QUESTIONS}
+      onSubmit={a => answers.push(a)}
+      onCancel={() => {}}
+    />,
+  )
+
+  try {
+    await h.waitFor('평소 어떤 AI 서비스를 쓰십니까?')
+    await h.type(ENTER)
+    await h.waitFor('전반적으로 얼마나 만족하셨습니까?')
+
+    // Back one step, pick a different service, then carry on to the end.
+    await h.type(ESC)
+    await h.waitFor('평소 어떤 AI 서비스를 쓰십니까?')
+    await h.type(DOWN)
+    await h.type(ENTER)
+    await h.waitFor('비교 대상: Claude')
+    await h.type(ENTER)
+
+    expect(answers).toEqual([{ service: 'claude', satisfaction: 'mid' }])
+  } finally {
+    h.stop()
+  }
+})
+
+test('renders the real questionnaire starting with the comparison service', async () => {
+  const h = await mount(
+    <SurveyForm
+      questions={SURVEY_QUESTIONS}
+      onSubmit={() => {}}
+      onCancel={() => {}}
+    />,
+  )
+
+  try {
+    await h.waitFor('평소 어떤 AI 서비스를 쓰십니까?')
+    const rendered = h.output()
+    expect(rendered).toContain(`1/${SURVEY_QUESTIONS.length}`)
+    expect(rendered).toContain('ChatGPT')
+    expect(rendered).toContain('거의 안 쓴다')
+    expect(rendered).toContain('↑↓ 고르기 · Enter 확인 · Esc 뒤로')
+  } finally {
+    h.stop()
+  }
+})
