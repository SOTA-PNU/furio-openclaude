+
+/** Axis of the parallel configuration the user is currently adjusting. */
+export type NpuAxis = 'dp' | 'pp'
+
+/**
+ * Values available on one axis while the other is held fixed.
+ *
+ * dp and pp are not independent — dp x pp is bounded by the card count, and the
+ * backend only advertises combinations it can actually serve. Offering a value
+ * the pair cannot reach would produce a model id that does not exist, so the
+ * choices are always derived from the advertised set.
+ */
+export function npuAxisValues(
+  modelId: string,
+  allValues: readonly string[],
+  axis: NpuAxis,
+  other: number,
+): number[] {
+  const variants = npuVariantsOf(modelId, allValues)
+  const vals = variants
+    .filter(v => (axis === 'dp' ? v.pp === other : v.dp === other))
+    .map(v => (axis === 'dp' ? v.dp : v.pp))
+  return [...new Set(vals)].sort((a, b) => a - b)
+}
+
+/**
+ * Moves one axis to its next value, keeping the pair valid: when the partner
+ * value cannot survive the move it falls back to the largest one that can.
+ * Returns null when the axis has nothing else to offer.
+ */
+export function stepNpuAxis(
+  modelId: string,
+  allValues: readonly string[],
+  axis: NpuAxis,
+  current: { dp: number; pp: number },
+  direction: 'left' | 'right',
+): { dp: number; pp: number } | null {
+  const other = axis === 'dp' ? current.pp : current.dp
+  let values = npuAxisValues(modelId, allValues, axis, other)
+  if (values.length < 2) {
+    // Nothing to move to while the partner is held — allow the move anyway by
+    // considering every value this axis can take, then repair the partner.
+    const all = npuVariantsOf(modelId, allValues).map(v => (axis === 'dp' ? v.dp : v.pp))
+    values = [...new Set(all)].sort((a, b) => a - b)
+    if (values.length < 2) return null
+  }
+  const cur = axis === 'dp' ? current.dp : current.pp
+  const i = values.indexOf(cur)
+  const base = i === -1 ? 0 : i
+  const next =
+    direction === 'right'
+      ? values[(base + 1) % values.length]!
+      : values[(base - 1 + values.length) % values.length]!
+  const partnerAxis: NpuAxis = axis === 'dp' ? 'pp' : 'dp'
+  let partner = other
+  const partnerChoices = npuAxisValues(modelId, allValues, partnerAxis, next)
+  if (!partnerChoices.includes(partner)) {
+    partner = partnerChoices.length > 0 ? partnerChoices[partnerChoices.length - 1]! : 1
+  }
+  return axis === 'dp' ? { dp: next, pp: partner } : { dp: partner, pp: next }
+}
