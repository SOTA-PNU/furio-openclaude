+/**
+ * Records that the user just picked `id`, moving it to the front.
+ *
+ * `rememberNpuModels` records what the *router* reports as up, in id order, so
+ * it cannot say which of several live models was chosen last. The switcher row
+ * is ordered by recency, so the pick itself has to be recorded when it happens.
+ */
+export function recordNpuModelSelection(base: string, id: string): string[] {
+  if (!base || !id) return []
+  const store = load()
+  const prev = store[base] ?? []
+  const next = [id, ...prev.filter(x => x !== id)].slice(0, MAX_PER_BASE)
+  store[base] = next
+  if (!sameOrder(prev, next)) persist(store)
+  return [...next]
+}
