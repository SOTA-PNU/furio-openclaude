+++ b/src/utils/surveyPrompt.test.ts
@@ -0,0 +1,163 @@
+import { beforeEach, describe, expect, it } from 'bun:test'
+import type { Message } from '../types/message.js'
+import {
+  findCompletionSignal,
+  maybeSuggestSurvey,
+  resetSurveySuggestionForTesting,
+} from './surveyPrompt.js'
+
+function human(text: string): Message {
+  return {
+    type: 'user',
+    message: { role: 'user', content: text },
+  } as unknown as Message
+}
+
+function bash(id: string, command: string): Message {
+  return {
+    type: 'assistant',
+    message: {
+      role: 'assistant',
+      content: [{ type: 'tool_use', id, name: 'Bash', input: { command } }],
+    },
+  } as unknown as Message
+}
+
+function result(id: string, isError = false): Message {
+  return {
+    type: 'user',
+    message: {
+      role: 'user',
+      content: [{ type: 'tool_result', tool_use_id: id, is_error: isError }],
+    },
+  } as unknown as Message
+}
+
+beforeEach(() => {
+  resetSurveySuggestionForTesting()
+})
+
+describe('findCompletionSignal', () => {
+  it('sees a commit that went through', () => {
+    expect(
+      findCompletionSignal([
+        human('커밋해줘'),
+        bash('t1', 'git commit -m "fix"'),
+        result('t1'),
+      ]),
+    ).toBe('커밋')
+  })
+
+  it('sees a test run across the runners', () => {
+    for (const command of [
+      'pytest -q',
+      'bun test src/',
+      'npm run test',
+      'cargo test --all',
+      'go test ./...',
+    ]) {
+      expect(
+        findCompletionSignal([human('go'), bash('t1', command), result('t1')]),
+      ).toBe('테스트')
+    }
+  })
+
+  it('is silent while the work is still failing', () => {
+    // A red test suite means the task is not finished — the worst possible
+    // moment to ask how satisfied someone is.
+    expect(
+      findCompletionSignal([
+        human('테스트 돌려줘'),
+        bash('t1', 'pytest -q'),
+        result('t1', true),
+      ]),
+    ).toBeUndefined()
+  })
+
+  it('ignores a dry run', () => {
+    expect(
+      findCompletionSignal([
+        human('확인만'),
+        bash('t1', 'git commit --dry-run'),
+        result('t1'),
+      ]),
+    ).toBeUndefined()
+  })
+
+  it('only reads the turn that just ended', () => {
+    // The commit belongs to an earlier turn; the current one only read a file.
+    expect(
+      findCompletionSignal([
+        human('커밋해줘'),
+        bash('t1', 'git commit -m "fix"'),
+        result('t1'),
+        human('이제 README 좀 보여줘'),
+        bash('t2', 'cat README.md'),
+        result('t2'),
+      ]),
+    ).toBeUndefined()
+  })
+
+  it('finds nothing in a turn without a finished unit of work', () => {
+    expect(
+      findCompletionSignal([human('빌드해줘'), bash('t1', 'bun run build'), result('t1')]),
+    ).toBeUndefined()
+  })
+})
+
+describe('maybeSuggestSurvey', () => {
+  const turn = [human('커밋해줘'), bash('t1', 'git commit -m "x"'), result('t1')]
+
+  function harness(promptedAt?: string) {
+    const lines: string[] = []
+    const written: string[] = []
+    return {
+      lines,
+      written,
+      run: (now = new Date('2026-10-23T12:00:00Z')) =>
+        maybeSuggestSurvey(turn, line => lines.push(line), {
+          now: () => now,
+          readPromptedAt: () => promptedAt,
+          writePromptedAt: iso => written.push(iso),
+        }),
+    }
+  }
+
+  it('offers the survey once and records when it did', () => {
+    const h = harness()
+    h.run()
+    expect(h.lines).toHaveLength(1)
+    expect(h.lines[0]).toContain('/survey')
+    expect(h.written).toEqual(['2026-10-23T12:00:00.000Z'])
+  })
+
+  it('does not ask twice in one session', () => {
+    const h = harness()
+    h.run()
+    h.run()
+    expect(h.lines).toHaveLength(1)
+  })
+
+  it('stays quiet for a day after asking', () => {
+    const h = harness('2026-10-23T06:00:00Z') // six hours ago
+    h.run()
+    expect(h.lines).toHaveLength(0)
+    expect(h.written).toHaveLength(0)
+  })
+
+  it('asks again once the day has passed', () => {
+    const h = harness('2026-10-21T06:00:00Z')
+    h.run()
+    expect(h.lines).toHaveLength(1)
+  })
+
+  it('says nothing when no work finished', () => {
+    const lines: string[] = []
+    maybeSuggestSurvey(
+      [human('뭐 하고 있어?')],
+      line => lines.push(line),
+      { readPromptedAt: () => undefined, writePromptedAt: () => {} },
+    )
+    expect(lines).toHaveLength(0)
+  })
+})
