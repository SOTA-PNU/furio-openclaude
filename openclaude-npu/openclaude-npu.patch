+    const sign = (ms: readonly NpuModel[]): string =>
+      ms.map(m => `${m.id}:${m.state}`).join('|')
+    let last = sign(currentNpuStatus.models)
+    const listener = (next: NpuStatus): void => {
+      const now = sign(next.models)
+      if (now === last) return
+      last = now
+      setModels(next.models)
+    }
+    npuStatusListeners.add(listener)
+    startNpuStatusPolling()
+
+    return () => {
+      npuStatusListeners.delete(listener)
+    }
+  }, [])
