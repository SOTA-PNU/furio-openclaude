new file mode 100644
index 00000000..ef2b04a9
--- /dev/null
+++ b/src/components/SurveyForm.tsx
@@ -0,0 +1,132 @@
+import * as React from 'react'
+import { useRegisterOverlay } from '../context/overlayContext.js'
+import { useTerminalSize } from '../hooks/useTerminalSize.js'
+import { Box, Text, useInput } from '../ink.js'
+import type { SurveyQuestion } from '../utils/survey.js'
+import { Select } from './CustomSelect/index.js'
+import TextInput from './TextInput.js'
+
+export type SurveyFormProps = {
+  questions: SurveyQuestion[]
+  onSubmit: (answers: Record<string, string>) => void
+  onCancel: () => void
+}
+
+/** Label of an already-given answer, for the "compared against" reminder. */
+function answeredLabel(
+  question: SurveyQuestion | undefined,
+  value: string | undefined,
+): string | undefined {
+  if (!question?.choices || !value) return undefined
+  return question.choices.find(choice => choice.value === value)?.label
+}
+
+/**
+ * The questionnaire, one question per screen: arrow keys move, Enter answers,
+ * Esc steps back (and leaves from the first question).
+ *
+ * One question at a time because every question but the first is answered
+ * *relative to* the first one, and because a single keypress per screen is the
+ * cheapest thing we can ask of someone who just finished their work.
+ */
+export function SurveyForm({
+  questions,
+  onSubmit,
+  onCancel,
+}: SurveyFormProps): React.ReactNode {
+  const [step, setStep] = React.useState(0)
+  const [answers, setAnswers] = React.useState<Record<string, string>>({})
+  const [text, setText] = React.useState('')
+  const [cursorOffset, setCursorOffset] = React.useState(0)
+  const { columns } = useTerminalSize()
+
+  const question = questions[step]
+
+  const goBack = React.useCallback(() => {
+    setText('')
+    setCursorOffset(0)
+    if (step === 0) onCancel()
+    else setStep(previous => previous - 1)
+  }, [step, onCancel])
+
+  const answer = React.useCallback(
+    (value: string) => {
+      if (!question) return
+      const next = { ...answers, [question.id]: value }
+      if (step + 1 >= questions.length) {
+        onSubmit(next)
+        return
+      }
+      setAnswers(next)
+      setStep(step + 1)
+    },
+    [answers, question, questions.length, step, onSubmit],
+  )
+
+  // The form owns Escape for every step, rather than letting each step's
+  // Select own it: one owner means no ordering question between the two, and
+  // the overlay stays registered for the whole form instead of churning as
+  // each question's Select unmounts and the next one mounts under the same
+  // overlay id. Registering keeps the REPL's cancel handler off our Escape.
+  useRegisterOverlay('survey')
+  useInput((_input, key) => {
+    if (key.escape) goBack()
+  })
+
+  if (!question) return null
+
+  const comparedWith = step > 0 ? answeredLabel(questions[0], answers[questions[0]?.id ?? '']) : undefined
+
+  return (
+    <Box flexDirection="column" gap={1} paddingX={1}>
+      <Box flexDirection="row" gap={1}>
+        <Text bold>furio 사용 경험 설문</Text>
+        <Text dimColor>
+          {step + 1}/{questions.length}
+          {comparedWith ? ` · 비교 대상: ${comparedWith}` : ''}
+        </Text>
+      </Box>
+
+      <Box flexDirection="column">
+        <Text>{question.prompt}</Text>
+        {question.hint ? <Text dimColor>{question.hint}</Text> : null}
+      </Box>
+
+      {question.choices ? (
+        <Select
+          key={question.id}
+          options={question.choices.map(choice => ({
+            label: choice.label,
+            value: choice.value,
+          }))}
+          onChange={value => answer(value)}
+          visibleOptionCount={question.choices.length}
+          defaultValue={answers[question.id] ?? question.defaultValue}
+          defaultFocusValue={answers[question.id] ?? question.defaultValue}
+        />
+      ) : (
+        <Box flexDirection="row" gap={1}>
+          <Text>›</Text>
+          <TextInput
+            value={text}
+            onChange={setText}
+            cursorOffset={cursorOffset}
+            onChangeCursorOffset={setCursorOffset}
+            columns={Math.max(20, columns - 8)}
+            onSubmit={value => {
+              const trimmed = value.trim()
+              if (!trimmed && !question.optional) return
+              answer(trimmed)
+            }}
+          />
+        </Box>
+      )}
+
+      <Text dimColor>
+        {question.choices
+          ? '↑↓ 고르기 · Enter 확인 · Esc 뒤로'
+          : 'Enter 보내기 · Esc 뒤로'}
+      </Text>
+    </Box>
+  )
+}
