+/**
+ * Remembers which NPU models were actually loaded, per router.
+ *
+ * The status line should keep showing the models you were just using even after
+ * the router forgets them (a restart, an LRU eviction, cards cleared) — but with
+ * their *real* current state, not a stale one. The router is the source of truth
+ * for what is up right now; this is the source of truth for "what was up before"
+ * so those rows can reappear in red instead of silently vanishing.
+ *
+ * Keyed by router base URL so two backends never bleed into each other. Persisted
+ * next to the rest of the config; every filesystem touch is guarded because a
+ * bad read or a full disk must never take down status polling.
+ */
+import { randomBytes } from 'node:crypto'
+import { existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { getClaudeConfigHomeDir } from '../utils/envUtils.js'
+
+const FILENAME = 'npu-recent-models.json'
+/** Enough to cover the four cards several times over without an unbounded list. */
+const MAX_PER_BASE = 8
+
+/** base URL → model ids, most-recently-loaded first. */
+type Store = Record<string, string[]>
+
+let cache: Store | null = null
+
+function cachePath(): string {
+  return join(getClaudeConfigHomeDir(), FILENAME)
+}
+
+function sanitize(parsed: unknown): Store {
+  const out: Store = {}
+  if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
+    for (const [k, v] of Object.entries(parsed as Record<string, unknown>)) {
+      if (Array.isArray(v)) {
+        out[k] = v.filter((x): x is string => typeof x === 'string' && x.length > 0).slice(0, MAX_PER_BASE)
+      }
+    }
+  }
+  return out
+}
+
+function load(): Store {
+  if (cache) return cache
+  try {
+    cache = sanitize(JSON.parse(readFileSync(cachePath(), 'utf-8')))
+  } catch {
+    cache = {}
+  }
+  return cache
+}
+
+function persist(store: Store): void {
+  try {
+    const dir = getClaudeConfigHomeDir()
+    if (!existsSync(dir)) mkdirSync(dir, { recursive: true })
+    const tmp = join(dir, `${FILENAME}.${randomBytes(6).toString('hex')}.tmp`)
+    writeFileSync(tmp, JSON.stringify(store, null, 2), { encoding: 'utf-8', mode: 0o600 })
+    renameSync(tmp, cachePath())
+  } catch {
+    // Memory-only fallback — a failed write must not break polling.
+  }
+}
+
+function sameOrder(a: readonly string[], b: readonly string[]): boolean {
+  if (a.length !== b.length) return false
+  for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return false
+  return true
+}
+
+/** Model ids remembered for this router, most-recent first. Empty when none. */
+export function getRememberedNpuModels(base: string): string[] {
+  if (!base) return []
+  return [...(load()[base] ?? [])]
+}
+
+/**
+ * Records that `ids` are loaded right now, and returns the full remembered list
+ * (these first, then previously-seen models), capped and most-recent first.
+ * Only writes to disk when the order actually changes, so a steady state costs
+ * nothing.
+ */
+export function rememberNpuModels(base: string, ids: readonly string[]): string[] {
+  if (!base) return []
+  const store = load()
+  const prev = store[base] ?? []
+  const merged: string[] = []
+  const seen = new Set<string>()
+  for (const id of [...ids, ...prev]) {
+    if (typeof id === 'string' && id && !seen.has(id)) {
+      seen.add(id)
+      merged.push(id)
+    }
+  }
+  const capped = merged.slice(0, MAX_PER_BASE)
+  store[base] = capped
+  if (!sameOrder(prev, capped)) persist(store)
+  return [...capped]
+}
+
+/** Test seam — drops the in-memory cache so a fresh file is read. */
+export function __resetNpuRecentModelsForTest(): void {
+  cache = null
+}
