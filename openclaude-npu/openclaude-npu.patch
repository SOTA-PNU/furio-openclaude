+/**
+ * Pulls the Furiosa router's `/router/models` and installs its descriptions and
+ * tp/pp metadata as the live source of truth (see setRuntimeNpuMeta). This is
+ * what lets a router-side change appear on the next launch without re-running
+ * install.sh. A non-Furiosa backend simply 404s and the env fallbacks remain.
+ */
+async function loadRouterMetadata(
+  baseUrl: string,
+  headers: Record<string, string>,
+): Promise<void> {
+  try {
+    const controller = new AbortController()
+    const abort = setTimeout(() => controller.abort(), 3000)
+    let res: Response
+    try {
+      res = await fetch(`${baseUrl}/router/models`, { headers, signal: controller.signal })
+    } finally {
+      clearTimeout(abort)
+    }
+    if (!res.ok) return
+    const body = (await res.json()) as { data?: Array<Record<string, unknown>> }
+    const rows = Array.isArray(body?.data) ? body.data : []
+    if (rows.length === 0) return
+    const desc: Record<string, string> = {}
+    const meta: Record<string, { tp_default: number; tps: number[]; pp_default?: number }> = {}
+    for (const r of rows) {
