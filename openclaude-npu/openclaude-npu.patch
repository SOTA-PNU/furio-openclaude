+/** Builds the model id for a configuration. dp1·pp1 is the bare model name. */
+export function variantId(value: string, dp: number, pp: number): string {
+  const { base } = parseNpuVariant(value)
+  return base + (dp > 1 ? `@dp${dp}` : '') + (pp > 1 ? `@pp${pp}` : '')
