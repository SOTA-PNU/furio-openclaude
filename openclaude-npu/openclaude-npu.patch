--- a/src/services/npuStatus.ts
+++ b/src/services/npuStatus.ts
@@ -49,7 +49,15 @@ export type NpuStatus = {
 const IDLE_INTERVAL_MS = 10_000
 /** While a model is loading/stopping we poll fast so the LED tracks reality. */
 const ACTIVE_INTERVAL_MS = 1_000
+/** But a big model can load for a minute or two, and every poll repaints the
+ *  whole TUI (the LED blinks). Polling at 1s for that entire time makes the
+ *  terminal feel sluggish, so after an initial fast window we back off to a
+ *  slower cadence — the LED still moves, just without hammering the screen. */
+const ACTIVE_FAST_WINDOW_MS = 12_000
+const ACTIVE_SLOW_INTERVAL_MS = 4_000
 const REQUEST_TIMEOUT_MS = 2_000
+/** When the current active (loading) phase began — null while idle. */
+let activeSince: number | null = null
 
 export const currentNpuStatus: NpuStatus = {
   models: [],
@@ -256,10 +264,17 @@ async function scheduledPoll(): Promise<void> {
   if (stopped) return
   // A preload the router hasn't acknowledged is as urgent as a visible
   // transition — that gap is exactly when the user is waiting for the LED.
-  const delay =
-    isTransitioning(currentNpuStatus.models) || pendingPreload.size > 0
-      ? ACTIVE_INTERVAL_MS
-      : IDLE_INTERVAL_MS
+  const active = isTransitioning(currentNpuStatus.models) || pendingPreload.size > 0
+  let delay: number
+  if (active) {
+    if (activeSince === null) activeSince = Date.now()
+    // Fast (1s) only for the first few seconds; then ease off so a long load
+    // doesn't repaint the terminal every second for a minute or two.
+    delay = Date.now() - activeSince < ACTIVE_FAST_WINDOW_MS ? ACTIVE_INTERVAL_MS : ACTIVE_SLOW_INTERVAL_MS
+  } else {
+    activeSince = null
+    delay = IDLE_INTERVAL_MS
+  }
   timer = setTimeout(scheduledPoll, delay)
 }
 
