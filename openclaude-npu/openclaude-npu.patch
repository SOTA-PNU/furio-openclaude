+  const push = (m: NpuModel, isCurrent: boolean) => {
+    seen.add(m.id);
+    const transitioning = m.state === 'loading' || m.state === 'stopping';
+    const glyph = transitioning ? (blinkOn ? LED_ON : LED_OFF) : LED_ON;
+    const color: keyof Theme | undefined =
+      m.state === 'up' ? 'success'
+      : transitioning ? 'warning'
+      : 'error';
+    const where = m.cards.length > 0 ? ` npu${m.cards.join(',')}` : '';
+    segments.push({
+      key: `npu:${m.id}`,
+      // Current model outranks context/cost so it survives a narrow terminal;
+      // the other cards' models yield first.
