+import type { UUID } from 'crypto'
+import * as React from 'react'
+import { getOriginalCwd, getSessionId } from '../../bootstrap/state.js'
+import { SessionFleet } from '../../components/SessionFleet.js'
+import { Text } from '../../ink.js'
+import { useAppState } from '../../state/AppState.js'
+import type {
+  LocalJSXCommandCall,
+  LocalJSXCommandOnDone,
+  ResumeEntrypoint,
+} from '../../types/command.js'
+import type { LogOption } from '../../types/logs.js'
+import { checkCrossProjectResume } from '../../utils/crossProjectResume.js'
+import { getWorktreePaths } from '../../utils/getWorktreePaths.js'
+import { getLogDisplayTitle, logError } from '../../utils/log.js'
+import { relaunchInProjectDir } from '../../utils/relaunchInProjectDir.js'
+import { deleteSessionFiles } from '../../utils/sessionDeletion.js'
+import {
+  getSessionIdFromLog,
+  getTranscriptPathForSession,
+  isLiteLog,
+  loadAllProjectsMessageLogs,
+  loadFullLog,
+} from '../../utils/sessionStorage.js'
+import { validateUuid } from '../../utils/uuid.js'
+import { filterResumableSessions } from '../resume/resume.js'
+
+type OnResume = (
+  sessionId: UUID,
+  log: LogOption,
+  entrypoint: ResumeEntrypoint,
+) => Promise<void>
+
+/** Titles for the first N rows are read from disk; the rest fill in as lite rows. */
+const ENRICH_COUNT = 80
+
+/**
+ * `/switch` — the `furio agents` view from inside a session. A session from
+ * this directory is resumed in place; one from another directory restarts
+ * furio over there, because its settings and trust decision live there.
+ */
+function SwitchSession({
+  onDone,
+  onResume,
+}: {
+  onDone: LocalJSXCommandOnDone
+  onResume: OnResume
+}): React.ReactNode {
+  const model = useAppState(s => s.mainLoopModel)
+  const [logs, setLogs] = React.useState<LogOption[] | null>(null)
+  const [worktreePaths, setWorktreePaths] = React.useState<string[]>([])
+  const [busy, setBusy] = React.useState(false)
+  const [notice, setNotice] = React.useState<string | undefined>()
+
+  const load = React.useCallback(async (): Promise<LogOption[]> => {
+    const all = await loadAllProjectsMessageLogs(undefined, {
+      initialEnrichCount: ENRICH_COUNT,
+    })
+    return filterResumableSessions(all, getSessionId())
+  }, [])
+
+  React.useEffect(() => {
+    void getWorktreePaths(getOriginalCwd()).then(setWorktreePaths)
+    load()
+      .then(loaded => {
+        if (loaded.length === 0) {
+          onDone('No saved sessions on this computer.', { display: 'system' })
+          return
+        }
+        setLogs(loaded)
+      })
+      .catch((error: unknown) => {
+        logError(error as Error)
+        onDone('Failed to load sessions', { display: 'system' })
+      })
+  }, [load, onDone])
+
+  const open = async (log: LogOption) => {
+    const sessionId = validateUuid(getSessionIdFromLog(log))
+    if (!sessionId) {
+      setNotice('That session has no id to resume.')
+      return
+    }
+    setBusy(true)
+    setNotice(undefined)
+    const cross = checkCrossProjectResume(log, true, worktreePaths)
+    if (cross.isCrossProject && !cross.isSameRepoWorktree) {
+      // Hands the terminal to a fresh furio in that directory and exits;
+      // only returns if it could not start one.
+      relaunchInProjectDir(cross.projectPath, sessionId)
+      setBusy(false)
+      setNotice(`Run this by hand: ${cross.command}`)
+      return
+    }
+    try {
+      const fullLog = isLiteLog(log) ? await loadFullLog(log) : log
+      if (isLiteLog(fullLog)) throw new Error('Transcript could not be loaded')
+      await onResume(sessionId, fullLog, 'slash_command_picker')
+    } catch (error) {
+      logError(error as Error)
+      setBusy(false)
+      setNotice(`Failed to open “${getLogDisplayTitle(log)}”: ${(error as Error).message}`)
+    }
+  }
+
+  const remove = async (log: LogOption) => {
+    const sessionId = getSessionIdFromLog(log) ?? ''
+    setBusy(true)
+    try {
+      const result = await deleteSessionFiles({
+        sessionId,
+        transcriptPath: log.fullPath ?? getTranscriptPathForSession(sessionId),
+        currentSessionId: getSessionId(),
+      })
+      if (!result.ok) {
+        setNotice(result.reason)
+        return
+      }
+      const remaining = await load()
+      if (remaining.length === 0) {
+        onDone('Deleted. No saved sessions left.', { display: 'system' })
+        return
+      }
+      setLogs(remaining)
+      setNotice(undefined)
+    } catch (error) {
+      logError(error as Error)
+      setNotice(`Failed to delete: ${(error as Error).message}`)
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  if (!logs) return <Text dimColor>Loading sessions…</Text>
+
+  return (
+    <SessionFleet
+      logs={logs}
+      cwd={getOriginalCwd()}
+      version={MACRO.DISPLAY_VERSION ?? MACRO.VERSION}
+      model={model ?? undefined}
+      onSelect={log => void open(log)}
+      onCancel={() => onDone(undefined, { display: 'skip' })}
+      onDelete={log => void remove(log)}
+      busy={busy}
+      notice={notice}
+    />
+  )
+}
+
+export const call: LocalJSXCommandCall = async (onDone, context) => {
+  const onResume: OnResume = async (sessionId, log, entrypoint) => {
+    try {
+      await context.resume?.(sessionId, log, entrypoint)
+      onDone(undefined, { display: 'skip' })
+    } catch (error) {
+      logError(error as Error)
+      onDone(`Failed to resume: ${(error as Error).message}`)
+    }
+  }
+  return <SwitchSession onDone={onDone} onResume={onResume} />
+}
