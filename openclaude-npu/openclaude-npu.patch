@@ -193,11 +193,14 @@ async function loadRouterMetadata(
   headers: Record<string, string>,
 ): Promise<void> {
   try {
+    // /router/models lives at the server root, not under /v1 — and the wrapper
+    // sets OPENAI_BASE_URL to `<server>/v1`, so strip a trailing /v1 first.
+    const routerRoot = baseUrl.replace(/\/v1$/, '')
     const controller = new AbortController()
     const abort = setTimeout(() => controller.abort(), 3000)
     let res: Response
     try {
-      res = await fetch(`${baseUrl}/router/models`, { headers, signal: controller.signal })
+      res = await fetch(`${routerRoot}/router/models`, { headers, signal: controller.signal })
     } finally {
       clearTimeout(abort)
     }
