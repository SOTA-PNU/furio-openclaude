+import { appendFile, mkdir } from 'fs/promises'
+import { dirname, join } from 'path'
+import { getClaudeConfigHomeDir } from './envUtils.js'
+
+export type SurveyChoice = {
+  /** Stable slug stored in the response; never translated. */
+  value: string
+  /** What the respondent reads. */
+  label: string
+}
+
+export type SurveyQuestion = {
+  id: string
+  prompt: string
+  /** Second line, for scale wording or a reminder. */
+  hint?: string
+  /** Choice list, or none for a free-text step. */
+  choices?: SurveyChoice[]
+  /** Option the cursor starts on — keeps a scale from anchoring at one end. */
+  defaultValue?: string
+  /** Free-text steps may be submitted empty. */
+  optional?: boolean
+}
+
+/**
+ * Five-point comparison against the service the respondent normally uses.
+ * The wording is the one the study asked for, so it stays verbatim.
+ */
+const COMPARISON: SurveyChoice[] = [
+  { value: 'much_worse', label: '훨씬 못함' },
+  { value: 'worse', label: '조금 못함' },
+  { value: 'same', label: '비슷함' },
+  { value: 'better', label: '조금 나음' },
+  { value: 'much_better', label: '훨씬 나음' },
+]
+
+/** Same five points for a count, where fewer is better. */
+const COMPARISON_COUNT: SurveyChoice[] = [
+  { value: 'many_more', label: '훨씬 많음' },
+  { value: 'more', label: '조금 많음' },
+  { value: 'same', label: '비슷함' },
+  { value: 'fewer', label: '조금 적음' },
+  { value: 'many_fewer', label: '훨씬 적음' },
+]
+
+/**
+ * The questionnaire. Order matters: question 0 names the service everything
+ * after it is compared against, so it has to come first.
+ *
+ * Items 1·2·4·6 are also measured on the router (TTFT, tokens/s, turn count,
+ * errors). They are kept here because the gap between what was measured and
+ * what was felt is the interesting part — not because the numbers are missing.
+ */
+export const SURVEY_QUESTIONS: SurveyQuestion[] = [
+  {
+    id: 'service',
+    prompt: '평소 어떤 AI 서비스를 쓰십니까?',
+    hint: '다음 문항들은 모두 그 서비스와 비교해 답해 주세요.',
+    choices: [
+      { value: 'chatgpt', label: 'ChatGPT' },
+      { value: 'claude', label: 'Claude' },
+      { value: 'gemini', label: 'Gemini' },
+      { value: 'copilot', label: 'GitHub Copilot' },
+      { value: 'local', label: '로컬·오픈소스 모델' },
+      { value: 'none', label: '거의 안 쓴다' },
+    ],
+  },
+  {
+    id: 'ttft',
+    prompt: '답이 나오기 시작할 때까지의 대기 시간은 어땠습니까?',
+    choices: COMPARISON,
+    defaultValue: 'same',
+  },
+  {
+    id: 'tps',
+    prompt: '글자가 나오는 속도는 어땠습니까?',
+    choices: COMPARISON,
+    defaultValue: 'same',
+  },
+  {
+    id: 'accuracy',
+    prompt: '답의 정확성은 어땠습니까?',
+    hint: '없는 함수를 만들어 내거나 틀린 설명을 섞는 정도를 생각해 주세요.',
+    choices: COMPARISON,
+    defaultValue: 'same',
+  },
+  {
+    id: 'retries',
+    prompt: '원하는 결과를 얻기까지 다시 요청한 횟수는 어땠습니까?',
+    choices: COMPARISON_COUNT,
+    defaultValue: 'same',
+  },
+  {
+    id: 'code_ran',
+    prompt: '받은 코드가 실제로 동작했습니까?',
+    choices: [
+      { value: 'ran_as_is', label: '그대로 동작했다' },
+      { value: 'ran_after_small_fix', label: '조금 고쳐서 동작했다' },
+      { value: 'needed_big_fix', label: '많이 고쳐야 했다' },
+      { value: 'unusable', label: '쓸 수 없었다' },
+      { value: 'no_code', label: '코드를 받는 작업이 아니었다' },
+    ],
+    defaultValue: 'ran_after_small_fix',
+  },
+  {
+    id: 'interrupted',
+    prompt: '도중에 끊기거나 멈춘 적이 있습니까?',
+    choices: [
+      { value: 'none', label: '없다' },
+      { value: 'once', label: '한 번' },
+      { value: 'few', label: '두세 번' },
+      { value: 'many', label: '여러 번' },
+    ],
+    defaultValue: 'none',
+  },
+  {
+    id: 'satisfaction',
+    prompt: '전반적으로 얼마나 만족하셨습니까?',
+    choices: [
+      { value: 'very_low', label: '매우 불만족' },
+      { value: 'low', label: '불만족' },
+      { value: 'mid', label: '보통' },
+      { value: 'high', label: '만족' },
+      { value: 'very_high', label: '매우 만족' },
+    ],
+    defaultValue: 'mid',
+  },
+  {
+    id: 'reuse',
+    prompt: '다음에도 이 서비스를 쓰시겠습니까?',
+    choices: [
+      { value: 'no', label: '쓰지 않겠다' },
+      { value: 'probably_no', label: '아마 안 쓴다' },
+      { value: 'unsure', label: '모르겠다' },
+      { value: 'probably_yes', label: '아마 쓴다' },
+      { value: 'yes', label: '꼭 쓴다' },
+    ],
+    defaultValue: 'unsure',
+  },
+  {
+    id: 'comment',
+    prompt: '덧붙일 말이 있으면 적어 주세요.',
+    hint: '없으면 그냥 Enter 를 누르면 됩니다.',
+    optional: true,
+  },
+]
+
+export type SurveySessionContext = {
+  messageCount: number
+  userTurns: number
+  assistantTurns: number
+}
+
+export type SurveyResponse = {
+  version: 1
+  submittedAt: string
+  sessionId: string
+  model?: string
+  clientVersion?: string
+  cwd?: string
+  session: SurveySessionContext
+  answers: Record<string, string>
+}
+
+/**
+ * Count the turns behind the answers, so a response carries its own context
+ * even when it never reaches the router.
+ */
+export function summarizeSession(
+  messages: ReadonlyArray<{ type?: string }>,
+): SurveySessionContext {
+  let userTurns = 0
+  let assistantTurns = 0
+  for (const message of messages) {
+    if (message.type === 'user') userTurns++
+    else if (message.type === 'assistant') assistantTurns++
+  }
+  return { messageCount: messages.length, userTurns, assistantTurns }
+}
+
+export function getSurveyFilePath(): string {
+  return join(getClaudeConfigHomeDir(), 'survey', 'responses.jsonl')
+}
+
+/**
+ * Where to send responses so the operator can collect them in one place.
+ *
+ * `FURIO_SURVEY_URL` wins. Otherwise we derive it from the endpoint this
+ * client already talks to — the router that served the session is also the
+ * one running the study, so a working furio needs no extra configuration.
+ */
+export function resolveSurveyEndpoint(
+  env: NodeJS.ProcessEnv = process.env,
+): string | undefined {
+  const explicit = env.FURIO_SURVEY_URL?.trim()
+  if (explicit) return explicit
+
+  const base = env.OPENAI_BASE_URL?.trim()
+  if (!base) return undefined
+  const root = base.replace(/\/+$/, '').replace(/\/v1$/, '')
+  if (!root) return undefined
+  return `${root}/survey/responses`
+}
+
+/**
+ * Write the response where it cannot be lost, then try to deliver it.
+ *
+ * The local file is the record of truth: a response is never dropped because
+ * the router was down or the session was offline. Delivery is best-effort and
+ * never blocks the answer being kept.
+ */
+export async function recordSurveyResponse(
+  response: SurveyResponse,
+  deps: {
+    endpoint?: string | undefined
+    fetchImpl?: typeof fetch
+    filePath?: string
+    timeoutMs?: number
+  } = {},
+): Promise<{ filePath: string; posted: boolean }> {
+  const filePath = deps.filePath ?? getSurveyFilePath()
+  const endpoint = 'endpoint' in deps ? deps.endpoint : resolveSurveyEndpoint()
+
+  let posted = false
+  if (endpoint) {
+    const send = deps.fetchImpl ?? fetch
+    try {
+      const res = await send(endpoint, {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify(response),
+        signal: AbortSignal.timeout(deps.timeoutMs ?? 3000),
+      })
+      posted = res.ok
+    } catch {
+      posted = false
+    }
+  }
+
+  await mkdir(dirname(filePath), { recursive: true })
+  await appendFile(filePath, `${JSON.stringify({ ...response, posted })}\n`, 'utf-8')
+
+  return { filePath, posted }
+}
diff --git a/src/utils/surveyPrompt.test.ts b/src/utils/surveyPrompt.test.ts
