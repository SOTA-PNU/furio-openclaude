+
+/**
+ * Drops parallelism variants whose base model is also present, so the picker
+ * lists `Qwen3-4B-FP8` once instead of once per dp/pp combination. A variant
+ * whose base is missing is kept — otherwise it would become unreachable.
+ */
+export function collapseNpuVariants(ids: readonly string[]): string[] {
+  const bases = new Set(ids.map(id => parseNpuVariant(id).base))
+  return ids.filter(id => {
+    const v = parseNpuVariant(id)
+    const isVariant = v.dp !== 1 || v.pp !== 1
+    return !isVariant || !bases.has(v.base)
+  })
