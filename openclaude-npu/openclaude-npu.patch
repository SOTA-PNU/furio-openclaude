+/**
+ * NPU status polling for the Furiosa router backend.
+ *
+ * The router (furiosa_router.py) lazy-serves models onto NPU cards and exposes
+ * `/router/status`. A tp32 model takes all 4 cards and needs ~2 minutes to load,
+ * so without this the UI is silent for the whole cold start. We surface each
+ * model's state so the status line can show it.
+ *
+ * Only active when the OpenAI-compatible base URL actually points at a Furiosa
+ * router: the first probe that 404s (or fails) disables polling for the session,
+ * so pointing openclaude at OpenAI/Ollama costs one request and nothing more.
+ */
+
+/** Server-side lifecycle of one model on the NPU cards. */
+export type NpuModelState = 'loading' | 'up' | 'stopping' | 'error' | 'down'
+
+export type NpuModel = {
+  /** Model id as the router knows it, e.g. `Qwen3-4B-FP8@dp2`. */
+  id: string
+  state: NpuModelState
+  /** NPU card indices this model occupies. */
+  cards: number[]
+  /** Data-parallel replicas / pipeline stages the model is served with. */
+  dp: number
+  pp: number
+}
+
+export type NpuStatus = {
+  models: NpuModel[]
+  freeCards: number[]
+  /**
+   * Increments on every successful poll. Consumers use it to drive the
+   * blink of transitioning models — terminals have no CSS animation, so the
+   * poll tick *is* the animation clock.
+   */
+  phase: number
+  /** False until the first successful poll, and after the router is ruled out. */
+  available: boolean
+}
+
+const IDLE_INTERVAL_MS = 10_000
+/** While a model is loading/stopping we poll fast so the LED tracks reality. */
+const ACTIVE_INTERVAL_MS = 1_000
+const REQUEST_TIMEOUT_MS = 2_000
+
+export const currentNpuStatus: NpuStatus = {
+  models: [],
+  freeCards: [],
+  phase: 0,
+  available: false,
+}
+
+export const npuStatusListeners = new Set<(status: NpuStatus) => void>()
+
+/**
+ * `OPENAI_BASE_URL` points at the OpenAI-compatible surface (`.../v1`);
+ * the router's own endpoints sit next to it. Returns null when unset.
+ */
+export function routerBaseUrl(env: NodeJS.ProcessEnv = process.env): string | null {
+  const base = env.OPENAI_BASE_URL ?? env.OPENAI_API_BASE
+  if (!base) return null
+  return base.replace(/\/+$/, '').replace(/\/v1$/, '')
+}
+
+export function isTransitioning(models: NpuModel[]): boolean {
+  return models.some(m => m.state === 'loading' || m.state === 'stopping')
+}
+
+function notify(): void {
+  for (const listener of npuStatusListeners) {
+    try {
+      listener({ ...currentNpuStatus })
+    } catch {
+      // A broken consumer must not kill the poll loop.
+    }
+  }
+}
+
+type RawStatus = {
+  running?: Record<
+    string,
+    { state?: string; cards?: number[]; dp?: number; pp?: number }
+  >
+  free_cards?: number[]
+}
+
+export function parseStatus(raw: RawStatus): Pick<NpuStatus, 'models' | 'freeCards'> {
+  const models: NpuModel[] = []
+  for (const [id, v] of Object.entries(raw.running ?? {})) {
+    const state = v?.state
+    models.push({
+      id,
+      state:
+        state === 'loading' || state === 'stopping' || state === 'error' || state === 'down'
+          ? state
+          : 'up',
+      cards: Array.isArray(v?.cards) ? v.cards : [],
+      dp: typeof v?.dp === 'number' ? v.dp : 1,
+      pp: typeof v?.pp === 'number' ? v.pp : 1,
+    })
+  }
+  // Stable order so the status line doesn't reshuffle between polls.
+  models.sort((a, b) => a.id.localeCompare(b.id))
+  return { models, freeCards: Array.isArray(raw.free_cards) ? raw.free_cards : [] }
+}
+
+let timer: ReturnType<typeof setTimeout> | null = null
+let stopped = false
+
+async function pollOnce(base: string): Promise<boolean> {
+  const controller = new AbortController()
+  const abort = setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS)
+  try {
+    const res = await fetch(`${base}/router/status`, { signal: controller.signal })
+    if (!res.ok) return false
+    const parsed = parseStatus((await res.json()) as RawStatus)
+    currentNpuStatus.models = parsed.models
+    currentNpuStatus.freeCards = parsed.freeCards
+    currentNpuStatus.phase += 1
+    currentNpuStatus.available = true
+    notify()
+    return true
+  } catch {
+    return false
+  } finally {
+    clearTimeout(abort)
+  }
+}
+
+/**
+ * Starts polling. Safe to call repeatedly — only the first call arms the loop.
+ * A failed *first* probe means this backend is not a Furiosa router, so we stop
+ * for good rather than retrying against someone else's OpenAI endpoint.
+ */
+export function startNpuStatusPolling(base = routerBaseUrl()): void {
+  if (timer !== null || stopped || !base) return
+  let everSucceeded = false
+  const loop = async (): Promise<void> => {
+    const ok = await pollOnce(base)
+    if (ok) {
+      everSucceeded = true
+    } else if (!everSucceeded) {
+      stopped = true // not a Furiosa router — stay quiet
+      currentNpuStatus.available = false
+      notify()
+      return
+    }
+    if (stopped) return
+    const delay = isTransitioning(currentNpuStatus.models)
+      ? ACTIVE_INTERVAL_MS
+      : IDLE_INTERVAL_MS
+    timer = setTimeout(loop, delay)
+  }
+  timer = setTimeout(loop, 0)
+}
+
+export function stopNpuStatusPolling(): void {
+  stopped = true
+  if (timer !== null) {
+    clearTimeout(timer)
+    timer = null
+  }
+}
+
+/** Test seam — resets module state between cases. */
+export function __resetNpuStatusForTest(): void {
+  stopNpuStatusPolling()
+  stopped = false
+  timer = null
+  currentNpuStatus.models = []
+  currentNpuStatus.freeCards = []
+  currentNpuStatus.phase = 0
+  currentNpuStatus.available = false
+  npuStatusListeners.clear()
+}
diff --git a/src/services/npuStatusHook.ts b/src/services/npuStatusHook.ts
new file mode 100644
index 00000000..5fb053a4
--- /dev/null
+++ b/src/services/npuStatusHook.ts
@@ -0,0 +1,30 @@
+import { useEffect, useState } from 'react'
+import {
+  currentNpuStatus,
+  type NpuStatus,
+  npuStatusListeners,
+  startNpuStatusPolling,
+} from './npuStatus.js'
+
+/**
+ * Subscribes to Furiosa NPU status updates and starts the poll loop on first
+ * mount. Re-renders on every poll tick, which is what animates the blink of
+ * models that are still loading — see `NpuStatus.phase`.
+ */
+export function useNpuStatus(): NpuStatus {
+  const [status, setStatus] = useState<NpuStatus>({ ...currentNpuStatus })
+
+  useEffect(() => {
+    const listener = (next: NpuStatus) => {
+      setStatus({ ...next })
+    }
+    npuStatusListeners.add(listener)
+    startNpuStatusPolling()
+
+    return () => {
+      npuStatusListeners.delete(listener)
+    }
+  }, [])
+
+  return status
+}
