+import * as React from 'react'
+import { getSessionId } from '../../bootstrap/state.js'
+import { Spinner } from '../../components/Spinner.js'
+import { SurveyForm } from '../../components/SurveyForm.js'
+import { Box, Text } from '../../ink.js'
+import { useAppState } from '../../state/AppState.js'
+import type {
+  LocalJSXCommandCall,
+  LocalJSXCommandOnDone,
+} from '../../types/command.js'
+import { getCwd } from '../../utils/cwd.js'
+import { errorMessage } from '../../utils/errors.js'
+import { logError } from '../../utils/log.js'
+import {
+  SURVEY_QUESTIONS,
+  recordSurveyResponse,
+  summarizeSession,
+  type SurveyResponse,
+} from '../../utils/survey.js'
+
+type Props = {
+  onDone: LocalJSXCommandOnDone
+  messages: ReadonlyArray<{ type?: string }>
+}
+
+function SurveyCommand({ onDone, messages }: Props): React.ReactNode {
+  const model = useAppState(s => s.mainLoopModel)
+  const [sending, setSending] = React.useState(false)
+
+  const handleSubmit = React.useCallback(
+    (answers: Record<string, string>) => {
+      setSending(true)
+      const response: SurveyResponse = {
+        version: 1,
+        submittedAt: new Date().toISOString(),
+        sessionId: getSessionId(),
+        model: model ?? process.env.OPENAI_MODEL,
+        // DISPLAY_VERSION is the number on the startup screen; VERSION is the
+        // build's internal one (99.0.0 outside a release build).
+        clientVersion: MACRO.DISPLAY_VERSION ?? MACRO.VERSION,
+        cwd: getCwd(),
+        session: summarizeSession(messages),
+        answers,
+      }
+      void recordSurveyResponse(response)
+        .then(({ filePath, posted }) => {
+          onDone(
+            posted
+              ? '설문 고맙습니다 — 보냈습니다.'
+              : `설문 고맙습니다 — ${filePath} 에 저장했습니다(서버에는 닿지 않았습니다).`,
+            { display: 'system' },
+          )
+        })
+        .catch(error => {
+          logError(error)
+          onDone(`설문을 저장하지 못했습니다: ${errorMessage(error)}`, {
+            display: 'system',
+          })
+        })
+    },
+    [messages, model, onDone],
+  )
+
+  const handleCancel = React.useCallback(() => {
+    onDone('설문을 닫았습니다. 나중에 /survey 로 다시 열 수 있습니다.', {
+      display: 'system',
+    })
+  }, [onDone])
+
+  if (sending) {
+    return (
+      <Box>
+        <Spinner />
+        <Text> 보내는 중…</Text>
+      </Box>
+    )
+  }
+
+  return (
+    <SurveyForm
+      questions={SURVEY_QUESTIONS}
+      onSubmit={handleSubmit}
+      onCancel={handleCancel}
+    />
+  )
+}
+
+export const call: LocalJSXCommandCall = async (onDone, context) => {
+  return <SurveyCommand onDone={onDone} messages={context.messages ?? []} />
+}
