+
+/**
+ * Like `useNpuStatus`, but re-renders only when a model's identity or state
+ * actually changes — never on a bare blink tick.
+ *
+ * The model picker colours its rows by load state, and rebuilds the whole
+ * option list whenever the status object changes. Subscribing it to the blink
+ * clock meant rebuilding and repainting that list once a second for the entire
+ * cold start of a model — exactly while the user is arrowing through it, which
+ * is what made the picker feel sluggish. The status line still blinks; it uses
+ * `useNpuStatus`.
+ */
+export function useNpuLoadStates(): NpuModel[] {
+  const [models, setModels] = useState<NpuModel[]>(currentNpuStatus.models)
+
