+/**
+ * Asks the router to start loading a model now.
+ *
+ * The router serves lazily, so without this a model only starts loading when
+ * the first message is sent — the user picks a model and nothing appears to
+ * happen for a minute or two. Fire-and-forget: the router returns immediately
+ * and progress shows up through /router/status as usual.
+ */
+export function preloadNpuModel(modelId: string, base = routerBaseUrl()): void {
+  if (!base || !modelId) return
+  const controller = new AbortController()
+  const abort = setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS)
+  void fetch(`${base}/router/preload`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ model: modelId }),
+    signal: controller.signal,
+  })
+    .catch(() => {
+      // Not a Furiosa router, or it declined — the model still loads on first use.
+    })
+    .finally(() => {
+      clearTimeout(abort)
+      // Poll fast so the LED reacts to the load we just started.
+      startNpuStatusPolling(base)
+    })
+}
