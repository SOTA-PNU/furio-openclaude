+import type { Message } from '../types/message.js'
+import { getGlobalConfig, saveGlobalConfig } from './config.js'
+import { isToolUseResultMessage } from './messages.js'
+
+/** How long a suggestion keeps the next one away. */
+const QUIET_HOURS = 20
+
+/**
+ * Commands that mark the end of a unit of work rather than a step inside one.
+ * A commit and a passing test suite are the two moments where someone is
+ * plainly between tasks — which is the only time it is fair to ask them
+ * anything at all.
+ */
+const COMPLETION_SIGNALS: { label: string; pattern: RegExp }[] = [
+  { label: '커밋', pattern: /\bgit\s+(?:-\S+\s+|--\S+\s+)*commit\b/ },
+  {
+    label: '테스트',
+    pattern:
+      /\b(?:pytest|tox|jest|vitest|ctest|(?:bun|npm|pnpm|yarn)\s+(?:run\s+)?test|cargo\s+test|go\s+test|make\s+test|mvn\s+test|gradle\s+test)\b/,
+  },
+]
+
+/** Things that look like a signal but finished nothing. */
+const NOT_A_SIGNAL = /--dry-run|--help|\s-h\b/
+
+let suggestedThisSession = false
+
+export function resetSurveySuggestionForTesting(): void {
+  suggestedThisSession = false
+}
+
+type ToolUseBlock = { type: string; id?: string; name?: string; input?: unknown }
+
+/**
+ * The command that finished a unit of work in the turn that just ended, or
+ * undefined if nothing did.
+ *
+ * Only the last turn is read: walking back stops at the human message that
+ * started it, so a commit from ten minutes ago cannot trigger a suggestion
+ * now. A tool call whose result came back as an error is not a signal — a
+ * failing test suite means the work is still in progress.
+ */
+export function findCompletionSignal(
+  messages: readonly Message[],
+): string | undefined {
+  const failedToolUses = new Set<string>()
+  const candidates: { id: string | undefined; label: string }[] = []
+
+  for (let i = messages.length - 1; i >= 0; i--) {
+    const message = messages[i]!
+
+    if (message.type === 'user') {
+      if (!isToolUseResultMessage(message)) break // start of this turn
+      const content = (message as { message?: { content?: unknown } }).message
+        ?.content
+      if (Array.isArray(content)) {
+        for (const block of content as {
+          type?: string
+          tool_use_id?: string
+          is_error?: boolean
+        }[]) {
+          if (block.type === 'tool_result' && block.is_error && block.tool_use_id) {
+            failedToolUses.add(block.tool_use_id)
+          }
+        }
+      }
+      continue
+    }
+
+    if (message.type !== 'assistant') continue
+    const content = (message as { message?: { content?: unknown } }).message
+      ?.content
+    if (!Array.isArray(content)) continue
+
+    for (const block of content as ToolUseBlock[]) {
+      if (block.type !== 'tool_use' || block.name !== 'Bash') continue
+      const command = (block.input as { command?: unknown } | undefined)?.command
+      if (typeof command !== 'string' || NOT_A_SIGNAL.test(command)) continue
+      const signal = COMPLETION_SIGNALS.find(entry => entry.pattern.test(command))
+      if (signal) candidates.push({ id: block.id, label: signal.label })
+    }
+  }
+
+  // Oldest first, so the suggestion names the work in the order it happened.
+  for (const candidate of candidates.reverse()) {
+    if (!candidate.id || !failedToolUses.has(candidate.id)) return candidate.label
+  }
+  return undefined
+}
+
+export type SurveySuggestionDeps = {
+  now?: () => Date
+  readPromptedAt?: () => string | undefined
+  writePromptedAt?: (iso: string) => void
+}
+
+/**
+ * Offer the survey once, right after a piece of work landed.
+ *
+ * It only ever prints one line and never interrupts: the respondent is in the
+ * middle of their own work, and a form that takes the terminal away from them
+ * would be answered once and resented after that.
+ */
+export function maybeSuggestSurvey(
+  messages: readonly Message[],
+  emit: (text: string) => void,
+  deps: SurveySuggestionDeps = {},
+): void {
+  if (suggestedThisSession) return
+
+  const now = deps.now?.() ?? new Date()
+  const readPromptedAt =
+    deps.readPromptedAt ?? (() => getGlobalConfig().surveyPromptedAt)
+  const lastPrompt = readPromptedAt()
+  if (lastPrompt) {
+    const elapsedHours = (now.getTime() - new Date(lastPrompt).getTime()) / 3_600_000
+    if (Number.isFinite(elapsedHours) && elapsedHours < QUIET_HOURS) return
+  }
+
+  const signal = findCompletionSignal(messages)
+  if (!signal) return
+
+  suggestedThisSession = true
+  const writePromptedAt =
+    deps.writePromptedAt ??
+    ((iso: string) => saveGlobalConfig(config => ({ ...config, surveyPromptedAt: iso })))
+  writePromptedAt(now.toISOString())
+
+  emit(
+    `${signal}까지 끝났네요 — 30초만 주시면 됩니다: /survey (오늘은 더 묻지 않습니다)`,
+  )
+}
