+import { setClaudeConfigHomeDirForTesting } from '../utils/envUtils.js'
+import {
+  __resetNpuRecentModelsForTest,
+  getRememberedNpuModels,
+  rememberNpuModels,
+} from './npuRecentModels.js'
+
+const BASE = 'http://127.0.0.1:8400'
+
+let dir: string
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), 'npu-recent-'))
+  setClaudeConfigHomeDirForTesting(dir)
+  __resetNpuRecentModelsForTest()
+})
+afterEach(() => {
+  setClaudeConfigHomeDirForTesting(undefined)
+  rmSync(dir, { recursive: true, force: true })
+})
+
+describe('npuRecentModels', () => {
+  test('remembers loaded models and survives a fresh read (persistence)', () => {
+    rememberNpuModels(BASE, ['A', 'B'])
+    __resetNpuRecentModelsForTest() // drop in-memory cache → forces a disk read
+    expect(getRememberedNpuModels(BASE)).toEqual(['A', 'B'])
+  })
+
+  test('keeps currently-loaded first, then previously-seen', () => {
+    rememberNpuModels(BASE, ['A', 'B'])
+    // Later poll: only C is up now; A and B were up before.
+    const out = rememberNpuModels(BASE, ['C'])
+    expect(out).toEqual(['C', 'A', 'B'])
+  })
+
+  test('never duplicates a model', () => {
+    rememberNpuModels(BASE, ['A'])
+    const out = rememberNpuModels(BASE, ['A', 'B'])
+    expect(out).toEqual(['A', 'B'])
+  })
+
+  test('caps the list so it cannot grow without bound', () => {
+    for (let i = 0; i < 20; i++) rememberNpuModels(BASE, [`m${i}`])
+    expect(getRememberedNpuModels(BASE).length).toBeLessThanOrEqual(8)
+    // Most-recent survives the cap.
+    expect(getRememberedNpuModels(BASE)[0]).toBe('m19')
+  })
+
+  test('keeps routers separate', () => {
+    rememberNpuModels('http://a:8400', ['A'])
+    rememberNpuModels('http://b:8400', ['B'])
+    expect(getRememberedNpuModels('http://a:8400')).toEqual(['A'])
+    expect(getRememberedNpuModels('http://b:8400')).toEqual(['B'])
+  })
+
+  test('a steady state does not rewrite (returns same order)', () => {
+    rememberNpuModels(BASE, ['A', 'B'])
+    expect(rememberNpuModels(BASE, ['A', 'B'])).toEqual(['A', 'B'])
+  })
+
+  test('ignores an empty base', () => {
+    expect(rememberNpuModels('', ['A'])).toEqual([])
+    expect(getRememberedNpuModels('')).toEqual([])
+  })
