+  // bf16 coder: 57GB -> needs >=2 cards, so its default build is pp2 (no pp1).
+  const META = JSON.stringify({ C: { tp_default: 8, tps: [8], pp_default: 2 } })
+  const ids = ['C', 'C@pp3', 'C@pp4']
+  beforeEach(() => { process.env.FURIO_NPU_META = META })
+  afterEach(() => { delete process.env.FURIO_NPU_META })
+
+  test('the bare id resolves to the default pp build (pp2)', () => {
+    expect(parseNpuVariant('C')).toMatchObject({ base: 'C', tp: 8, dp: 1, pp: 2 })
+    expect(parseNpuVariant('C@pp3').pp).toBe(3)
+  })
+
+  test('the pp axis lists the offered builds, not pp1', () => {
+    expect(npuAxisAllValues('C', ids, 'pp')).toEqual([2, 3, 4])
+  })
+
+  test('@pp is composed only when it is not the default', () => {
+    expect(variantId('C', 8, 1, 2)).toBe('C')
+    expect(variantId('C', 8, 1, 3)).toBe('C@pp3')
+    expect(variantId('C', 8, 1, 4)).toBe('C@pp4')
+  })
+
+  test('a single-build model has no tp axis', () => {
+    expect(npuAxisAllValues('C', ids, 'tp')).toEqual([8])
