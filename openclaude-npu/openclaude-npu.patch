+      text: `${isCurrent ? '▶' : ''}${glyph} ${m.id}${where}`,
+      shortText: `${isCurrent ? '▶' : ''}${glyph} ${m.id}`,
+      color,
+    });
+  };
+
+  const current = currentModelId ? npu.models.find(m => m.id === currentModelId) : undefined;
+  if (current) {
