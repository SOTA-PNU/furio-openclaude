+      const base = typeof r.base === 'string' ? r.base : null
+      if (base && typeof r.tp_default === 'number' && Array.isArray(r.tp_choices)) {
+        meta[base] = {
+          tp_default: r.tp_default,
+          tps: (r.tp_choices as unknown[]).filter((n): n is number => typeof n === 'number'),
+          ...(typeof r.pp_default === 'number' ? { pp_default: r.pp_default } : {}),
+        }
+      }
+    }
+    if (Object.keys(desc).length > 0) setRuntimeDescriptions(desc)
+    if (Object.keys(meta).length > 0) setRuntimeNpuMeta(meta)
+    logForDebugging(`[ModelDiscovery] router meta: ${Object.keys(meta).length} models`)
+  } catch {
+    // Router unreachable or non-Furiosa backend — keep the env-var fallbacks.
+  }
+}
