+/**
+ * Which models are on the cards, keyed by base id.
+ *
+ * The picker lists one row per model while the router reports one entry per
+ * parallel configuration, so `Llama-3.1-8B-Instruct@dp2` has to light up the
+ * `Llama-3.1-8B-Instruct` row. A model already serving under *some*
+ * configuration is available to switch to, which is what the row needs to say.
+ *
+ * `up` wins over `loading` when both are present — some card is ready now.
+ */
+export function npuLoadStatesByBase(
+  models: readonly { id: string; state: string }[],
+): Map<string, 'up' | 'busy'> {
+  const out = new Map<string, 'up' | 'busy'>()
+  for (const m of models) {
+    const { base } = parseNpuVariant(m.id)
+    if (m.state === 'up') out.set(base, 'up')
+    else if ((m.state === 'loading' || m.state === 'stopping') && out.get(base) !== 'up') {
+      out.set(base, 'busy')
+    }
+  }
+  return out
+}
+
+/**
+ * Colours each option by whether its model is on the cards: green for loaded,
+ * yellow while it moves. Options the router says nothing about are left alone.
+ *
+ * Without this only the *selected* model reads as green, which hides the whole
+ * point of holding several models across the four cards — you cannot see which
+ * ones are a free switch and which mean a two-minute cold start.
+ */
+export function applyNpuLoadColors<T extends { value?: string | null; color?: string }>(
+  options: readonly T[],
+  loaded: Map<string, 'up' | 'busy'>,
+): T[] {
+  if (loaded.size === 0) return options as T[]
+  return options.map(o => {
+    if (typeof o.value !== 'string') return o
+    const state = loaded.get(parseNpuVariant(o.value).base)
+    if (!state) return o
+    return { ...o, color: state === 'up' ? 'success' : 'warning' }
+  })
+}
