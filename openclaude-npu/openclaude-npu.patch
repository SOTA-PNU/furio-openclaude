@@ -0,0 +1,76 @@
+import { spawnSync } from 'child_process'
+import instances from '../ink/instances.js'
+
+export type RelaunchDeps = {
+  /** Overridable for tests; defaults to `child_process.spawnSync`. */
+  spawnProcess?: typeof spawnSync
+  /** Script to re-run; defaults to the entrypoint this process was started from. */
+  entrypoint?: string | undefined
+  /** Overridable for tests; defaults to `process.exit`. */
+  exitProcess?: (code: number) => void
+  /** Overridable for tests; defaults to releasing the live Ink instance. */
+  releaseTerminal?: () => void
+}
+
+/**
+ * Stop drawing and let go of the keyboard before a child takes the terminal.
+ *
+ * Two Ink apps on one terminal fight over the screen and split the user's
+ * keystrokes between them, so the parent has to step aside first. We never
+ * resume: the child owns the terminal until it exits, and then we exit too.
+ */
+function releaseTerminalToChild(): void {
+  const ink = instances.get(process.stdout)
+  ink?.pause()
+  ink?.suspendStdin()
+}
+
+/**
+ * Hand the terminal to a fresh session started in another project directory.
+ *
+ * A session belongs to the directory it was opened in: settings, CLAUDE.md,
+ * the workspace trust decision and the MCP servers are all resolved for that
+ * directory while we start up, so a session from elsewhere cannot be adopted
+ * by chdir'ing mid-flight. Instead we start ourselves again — same
+ * interpreter, same script, new working directory — and exit with the child's
+ * status. That is the `cd <dir> && furio --resume <id>` the user would
+ * otherwise type, run for them.
+ *
+ * Returns false when no relaunch was attempted (the entrypoint is unknown, so
+ * the caller should fall back to printing the command). Otherwise the process
+ * exits and the `true` is never observed outside tests.
+ */
+export function relaunchInProjectDir(
+  projectPath: string,
+  sessionId: string,
+  deps: RelaunchDeps = {},
+): boolean {
+  const entrypoint = 'entrypoint' in deps ? deps.entrypoint : process.argv[1]
+  if (!entrypoint) return false
+
+  const spawnProcess = deps.spawnProcess ?? spawnSync
+  const releaseTerminal = deps.releaseTerminal ?? releaseTerminalToChild
+  const exitProcess =
+    deps.exitProcess ??
+    // eslint-disable-next-line custom-rules/no-process-exit
+    ((code: number) => process.exit(code))
+
+  releaseTerminal()
+
+  const result = spawnProcess(
+    process.execPath,
+    [...process.execArgv, entrypoint, '--resume', sessionId],
+    { cwd: projectPath, stdio: 'inherit', env: process.env },
+  )
+
+  if (result.error) {
+    process.stderr.write(
+      `Could not start a session in ${projectPath}: ${result.error.message}\n`,
+    )
+    exitProcess(1)
+    return true
+  }
+
+  exitProcess(result.status ?? 0)
+  return true
+}
