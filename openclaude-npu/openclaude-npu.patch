@@ -0,0 +1,142 @@
+import { afterEach, describe, expect, it } from 'bun:test'
+import { mkdtempSync, readFileSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import {
+  SURVEY_QUESTIONS,
+  recordSurveyResponse,
+  resolveSurveyEndpoint,
+  summarizeSession,
+  type SurveyResponse,
+} from './survey.js'
+
+const dirs: string[] = []
+function tmpFile(): string {
+  const dir = mkdtempSync(join(tmpdir(), 'survey-'))
+  dirs.push(dir)
+  return join(dir, 'nested', 'responses.jsonl')
+}
+
+afterEach(() => {
+  while (dirs.length) rmSync(dirs.pop()!, { recursive: true, force: true })
+})
+
+function response(): SurveyResponse {
+  return {
+    version: 1,
+    submittedAt: '2026-10-23T00:00:00.000Z',
+    sessionId: 'session-1',
+    session: { messageCount: 4, userTurns: 2, assistantTurns: 2 },
+    answers: { satisfaction: 'high' },
+  }
+}
+
+describe('SURVEY_QUESTIONS', () => {
+  it('has unique ids and ends with the optional free-text step', () => {
+    const ids = SURVEY_QUESTIONS.map(q => q.id)
+    expect(new Set(ids).size).toBe(ids.length)
+    const last = SURVEY_QUESTIONS.at(-1)!
+    expect(last.choices).toBeUndefined()
+    expect(last.optional).toBe(true)
+  })
+
+  it('names the comparison service first', () => {
+    // Every later question is answered relative to this one, so it cannot move.
+    expect(SURVEY_QUESTIONS[0]!.id).toBe('service')
+  })
+
+  it('starts each scale on an option that exists', () => {
+    for (const question of SURVEY_QUESTIONS) {
+      if (!question.defaultValue) continue
+      const values = (question.choices ?? []).map(c => c.value)
+      expect(values).toContain(question.defaultValue)
+    }
+  })
+})
+
+describe('summarizeSession', () => {
+  it('counts user and assistant turns', () => {
+    expect(
+      summarizeSession([
+        { type: 'user' },
+        { type: 'assistant' },
+        { type: 'assistant' },
+        { type: 'system' },
+      ]),
+    ).toEqual({ messageCount: 4, userTurns: 1, assistantTurns: 2 })
+  })
+})
+
+describe('resolveSurveyEndpoint', () => {
+  it('prefers an explicit URL', () => {
+    expect(
+      resolveSurveyEndpoint({
+        FURIO_SURVEY_URL: 'http://host/collect',
+        OPENAI_BASE_URL: 'http://router:8400/v1',
+      } as NodeJS.ProcessEnv),
+    ).toBe('http://host/collect')
+  })
+
+  it('derives it from the router the client already talks to', () => {
+    // No extra configuration: the router serving the model collects the study.
+    expect(
+      resolveSurveyEndpoint({
+        OPENAI_BASE_URL: 'http://router:8400/v1',
+      } as NodeJS.ProcessEnv),
+    ).toBe('http://router:8400/survey/responses')
+    expect(
+      resolveSurveyEndpoint({
+        OPENAI_BASE_URL: 'http://router:8400/v1/',
+      } as NodeJS.ProcessEnv),
+    ).toBe('http://router:8400/survey/responses')
+  })
+
+  it('is undefined with nothing to go on', () => {
+    expect(resolveSurveyEndpoint({} as NodeJS.ProcessEnv)).toBeUndefined()
+  })
+})
+
+describe('recordSurveyResponse', () => {
+  it('posts the response and records that it was delivered', async () => {
+    const filePath = tmpFile()
+    const seen: { url: string; body: unknown }[] = []
+    const result = await recordSurveyResponse(response(), {
+      filePath,
+      endpoint: 'http://router/survey/responses',
+      fetchImpl: (async (url: string, init: { body: string }) => {
+        seen.push({ url, body: JSON.parse(init.body) })
+        return { ok: true } as Response
+      }) as unknown as typeof fetch,
+    })
+
+    expect(result.posted).toBe(true)
+    expect(seen[0]!.url).toBe('http://router/survey/responses')
+    const stored = JSON.parse(readFileSync(filePath, 'utf-8').trim())
+    expect(stored.posted).toBe(true)
+    expect(stored.answers.satisfaction).toBe('high')
+  })
+
+  it('keeps the answer locally when the router cannot be reached', async () => {
+    const filePath = tmpFile()
+    const result = await recordSurveyResponse(response(), {
+      filePath,
+      endpoint: 'http://router/survey/responses',
+      fetchImpl: (async () => {
+        throw new Error('ECONNREFUSED')
+      }) as unknown as typeof fetch,
+    })
+
+    // The local file is the record of truth — a response is never dropped
+    // because the server was down.
+    expect(result.posted).toBe(false)
+    expect(JSON.parse(readFileSync(filePath, 'utf-8').trim()).posted).toBe(false)
+  })
+
+  it('appends, one response per line', async () => {
+    const filePath = tmpFile()
+    const noEndpoint = { filePath, endpoint: undefined }
+    await recordSurveyResponse(response(), noEndpoint)
+    await recordSurveyResponse(response(), noEndpoint)
+    expect(readFileSync(filePath, 'utf-8').trim().split('\n')).toHaveLength(2)
+  })
+})
