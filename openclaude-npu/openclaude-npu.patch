+
+import { describe, expect, it, test } from 'bun:test'
+import React from 'react'
+
+import { render } from '../ink.js'
+import { AppStateProvider, getDefaultAppState } from '../state/AppState.js'
+import type { LogOption } from '../types/logs.js'
+import { ageLabel, buildFleetRows, SessionFleet, shortenHome } from './SessionFleet.js'
+
+const DOWN = '\u001B[B'
+const UP = '\u001B[A'
+const ENTER = '\r'
+const ESC = '\u001B'
+const CTRL_X = '\u0018'
+
+function log(partial: Partial<LogOption> & { sessionId: string }): LogOption {
+  return {
+    date: '2026-10-23T00:00:00.000Z',
+    messages: [],
+    value: 0,
+    created: new Date('2026-10-23T00:00:00Z'),
+    modified: new Date('2026-10-23T00:00:00Z'),
+    firstPrompt: '',
+    messageCount: 3,
+    isSidechain: false,
+    isLite: true,
+    ...partial,
+  } as LogOption
+}
+
+const NOW = new Date('2026-10-23T12:00:00Z')
+const LOGS: LogOption[] = [
+  log({ sessionId: 'aaaa', projectPath: '/home/u/repo', firstPrompt: '테스트 고쳐줘', modified: new Date('2026-10-23T11:00:00Z') }),
+  log({ sessionId: 'bbbb', projectPath: '/home/u/other', customTitle: 'docs sweep', firstPrompt: 'README 정리', modified: new Date('2026-10-23T11:30:00Z') }),
+  log({ sessionId: 'cccc', projectPath: '/home/u/repo', firstPrompt: 'build 실패 원인', modified: new Date('2026-10-20T11:00:00Z') }),
+]
+
+describe('buildFleetRows', () => {
+  it('puts the current directory first and groups the rest newest first', () => {
+    const rows = buildFleetRows(LOGS, '/home/u/repo')
+    expect(rows.map(r => (r.kind === 'group' ? `#${r.label}` : r.key))).toEqual([
+      '#/home/u/repo', 'aaaa', 'cccc',
+      '#/home/u/other', 'bbbb',
+    ])
+    // Without a current-directory group, newest activity decides the order.
+    const elsewhere = buildFleetRows(LOGS, '/nowhere')
+    expect(elsewhere[0]).toEqual({ kind: 'group', label: '/home/u/other', isCurrent: false })
+  })
+})
+
+describe('labels', () => {
+  it('abbreviates the home directory', () => {
+    const home = require('node:os').homedir() as string
+    expect(shortenHome(home)).toBe('~')
+    expect(shortenHome(`${home}/x/y`)).toBe('~/x/y')
+    expect(shortenHome('/srv/app')).toBe('/srv/app')
+  })
+
+  it('prints ages the way the header row expects', () => {
+    expect(ageLabel(new Date('2026-10-23T11:00:00Z'), NOW)).toBe('1h')
+    expect(ageLabel(new Date('2026-10-23T11:52:00Z'), NOW)).toBe('8m')
+    expect(ageLabel(new Date('2026-07-16T12:00:00Z'), NOW)).toBe('3mo')
+  })
+})
+
+type Harness = {
+  output: () => string
+  type: (keys: string) => Promise<void>
+  waitFor: (text: string) => Promise<void>
+  stop: () => void
+}
+
+async function mount(element: React.ReactElement, columns = 110, rows = 40): Promise<Harness> {
+  let output = ''
+  const stdout = new PassThrough()
+  const stdin = new PassThrough() as PassThrough & {
+    isTTY: boolean
+    setRawMode: (mode: boolean) => void
+    ref: () => void
+    unref: () => void
+  }
+  stdin.isTTY = true
+  stdin.setRawMode = () => {}
+  stdin.ref = () => {}
+  stdin.unref = () => {}
+  ;(stdout as unknown as { columns: number; rows: number }).columns = columns
+  ;(stdout as unknown as { columns: number; rows: number }).rows = rows
+  stdout.on('data', chunk => {
+    output += chunk.toString()
+  })
+  const instance = await render(
+    <AppStateProvider initialState={getDefaultAppState()}>{element}</AppStateProvider>,
+    {
+      stdin: stdin as unknown as NodeJS.ReadStream,
+      stdout: stdout as unknown as NodeJS.WriteStream,
+      exitOnCtrlC: false,
+    },
+  )
+  const waitFor = async (text: string): Promise<void> => {
+    const startedAt = Date.now()
+    while (Date.now() - startedAt < 2000) {
+      if (stripAnsi(output).includes(text)) return
+      await Bun.sleep(10)
+    }
+    throw new Error(`Timed out waiting for ${JSON.stringify(text)}`)
+  }
+  return {
+    output: () => stripAnsi(output),
+    // A lone Escape is held 300ms by the parser (it might start a sequence).
+    type: async (keys: string) => {
+      output = ''
+      stdin.write(keys)
+      await Bun.sleep(keys === ESC ? 400 : 40)
+    },
+    waitFor,
+    stop: () => {
+      instance.unmount()
+      stdin.end()
+      stdout.end()
+    },
+  }
+}
+
+const baseProps = {
+  cwd: '/home/u/repo',
+  version: '0.33.0',
+  model: 'gpt-oss-120b',
+  onCancel: () => {},
+}
+
+test('renders the header and the sessions grouped by directory', async () => {
+  const h = await mount(<SessionFleet {...baseProps} logs={LOGS} onSelect={() => {}} />)
+  try {
+    await h.waitFor('New sessions:')
+    const out = h.output()
+    expect(out).toContain('v0.33.0')
+    expect(out).toContain('gpt-oss-120b · /home/u/repo')
+    expect(out).toContain('3 sessions · 2 projects')
+    // Group header, then its rows; the focused row carries the pointer.
+    expect(out.indexOf('/home/u/repo')).toBeLessThan(out.indexOf('테스트 고쳐줘'))
+    expect(out).toContain('❯ •')
+    expect(out).toContain('docs sweep')
+    expect(out).toContain('README 정리') // detail column when the title is a custom one
+  } finally {
+    h.stop()
+  }
+})
+
+test('arrow keys move across groups and Enter opens the focused session', async () => {
+  const picked: string[] = []
+  const h = await mount(
+    <SessionFleet {...baseProps} logs={LOGS} onSelect={l => picked.push(l.sessionId!)} />,
+  )
+  try {
+    await h.waitFor('New sessions:')
+    await h.type(DOWN) // cccc (same group)
+    await h.type(DOWN) // bbbb (next group)
+    await h.type(ENTER)
+    expect(picked).toEqual(['bbbb'])
+    await h.type(UP)
+    await h.type(ENTER)
+    expect(picked).toEqual(['bbbb', 'cccc'])
+  } finally {
+    h.stop()
+  }
+})
+
+test('the text box starts a new session, and Enter on an empty box opens the focused one', async () => {
+  const picked: string[] = []
+  const started: string[] = []
+  const h = await mount(
+    <SessionFleet
+      {...baseProps}
+      logs={LOGS}
+      onSelect={l => picked.push(l.sessionId!)}
+      onNewSession={p => started.push(p)}
+    />,
+  )
+  try {
+    await h.waitFor('describe a task for a new session')
+    await h.type(ENTER)
+    expect(picked).toEqual(['aaaa'])
+    await h.type(DOWN) // arrows reach the list through the box
+    await h.type('fix the build')
+    await h.type(ENTER)
+    expect(started).toEqual(['fix the build'])
+  } finally {
+    h.stop()
+  }
+})
+
+test('ctrl+x asks once and deletes on the second press; Esc leaves', async () => {
+  const deleted: string[] = []
+  let cancelled = 0
+  const h = await mount(
+    <SessionFleet
+      {...baseProps}
+      logs={LOGS}
+      onSelect={() => {}}
+      onDelete={l => deleted.push(l.sessionId!)}
+      onCancel={() => {
+        cancelled++
+      }}
+    />,
+  )
+  try {
+    await h.waitFor('New sessions:')
+    await h.type(CTRL_X)
+    await h.waitFor('Press ctrl+x again')
+    expect(deleted).toEqual([])
+    await h.type(CTRL_X)
+    expect(deleted).toEqual(['aaaa'])
+    await h.type(ESC)
+    expect(cancelled).toBe(1)
+  } finally {
+    h.stop()
+  }
+})
diff --git a/src/components/SessionFleet.tsx b/src/components/SessionFleet.tsx
new file mode 100644
index 00000000..7f6e2456
--- /dev/null
+++ b/src/components/SessionFleet.tsx
@@ -0,0 +1,329 @@
+import { homedir } from 'os'
+import * as React from 'react'
+import { useRegisterOverlay } from '../context/overlayContext.js'
+import { useTerminalSize } from '../hooks/useTerminalSize.js'
+import { Box, Text, useInput } from '../ink.js'
+import type { LogOption } from '../types/logs.js'
+import { formatRelativeTime, truncateToWidth } from '../utils/format.js'
+import { getLogDisplayTitle } from '../utils/log.js'
+import { getSessionIdFromLog } from '../utils/sessionStorage.js'
+import { WordmarkRow } from './LogoV2/WordmarkRow.js'
+import { Spinner } from './Spinner.js'
+import TextInput from './TextInput.js'
+
+export type SessionFleetProps = {
+  logs: LogOption[]
+  /** Directory furio was started in; its sessions are listed first. */
+  cwd: string
+  version: string
+  model?: string
+  onSelect: (log: LogOption) => void
+  onCancel: () => void
+  /**
+   * Start a fresh session from the text box at the bottom. When omitted the
+   * box is not drawn and the arrow keys are read directly.
+   */
+  onNewSession?: (prompt: string) => void
+  /** ctrl+x twice on a row. When omitted the hint is not shown. */
+  onDelete?: (log: LogOption) => void
+  busy?: boolean
+  notice?: string
+}
+
+export type FleetRow =
+  | { kind: 'group'; label: string; isCurrent: boolean }
+  | { kind: 'log'; log: LogOption; key: string }
+
+export function rowKey(log: LogOption): string {
+  return getSessionIdFromLog(log) ?? log.fullPath ?? String(log.value)
+}
+
+export function shortenHome(path: string): string {
+  const home = homedir()
+  if (path === home) return '~'
+  return path.startsWith(`${home}/`) ? `~${path.slice(home.length)}` : path
+}
+
+/** "1h", "8m", "99d" — the narrow form without "ago". */
+export function ageLabel(date: Date | string, now: Date = new Date()): string {
+  return formatRelativeTime(new Date(date), { style: 'narrow', now })
+    .replace(/ ago$/, '')
+    .replace(/^in /, '')
+}
+
+function modifiedMs(log: LogOption): number {
+  return new Date(log.modified).getTime()
+}
+
+/**
+ * Sessions grouped by the directory they were opened in, the current
+ * directory first and the rest newest first; inside a group newest first.
+ *
+ * Grouping by directory is the point of the view: a session only makes sense
+ * next to its project, and the directory is what decides whether opening it
+ * is a resume in place or a relaunch somewhere else.
+ */
+export function buildFleetRows(logs: LogOption[], cwd: string): FleetRow[] {
+  const groups = new Map<string, LogOption[]>()
+  for (const log of logs) {
+    const dir = log.projectPath ?? ''
+    const list = groups.get(dir)
+    if (list) list.push(log)
+    else groups.set(dir, [log])
+  }
+  const newest = (dir: string): number =>
+    Math.max(...groups.get(dir)!.map(modifiedMs))
+  const dirs = [...groups.keys()].sort((a, b) => {
+    if (a === cwd) return -1
+    if (b === cwd) return 1
+    return newest(b) - newest(a)
+  })
+
+  const rows: FleetRow[] = []
+  for (const dir of dirs) {
+    rows.push({
+      kind: 'group',
+      label: dir ? shortenHome(dir) : '(unknown directory)',
+      isCurrent: dir === cwd,
+    })
+    for (const log of [...groups.get(dir)!].sort((a, b) => modifiedMs(b) - modifiedMs(a))) {
+      rows.push({ kind: 'log', log, key: rowKey(log) })
+    }
+  }
+  return rows
+}
+
+/**
+ * The second column: the first prompt when the title is something else;
+ * otherwise the size. A lite row has not been read yet, so its message count
+ * is unknown rather than zero — the file size is what we do know.
+ */
+function detailOf(log: LogOption, title: string): string {
+  const first = (log.firstPrompt ?? '').replace(/\s+/g, ' ').trim()
+  if (first && first !== title) return first
+  const parts: string[] = []
+  if (log.messageCount > 0) parts.push(`${log.messageCount} messages`)
+  else if (log.fileSize) parts.push(`${Math.max(1, Math.round(log.fileSize / 1024))}KB`)
+  if (log.gitBranch) parts.push(log.gitBranch)
+  return parts.join(' · ')
+}
+
+/**
+ * The machine-wide session view: every session furio has opened on this
+ * computer, grouped by project, one line each. Enter opens the focused one,
+ * ctrl+x twice deletes it, and typing starts a new session from here.
+ */
+export function SessionFleet({
+  logs,
+  cwd,
+  version,
+  model,
+  onSelect,
+  onCancel,
+  onNewSession,
+  onDelete,
+  busy = false,
+  notice,
+}: SessionFleetProps): React.ReactNode {
+  const { rows: termRows, columns } = useTerminalSize()
+  const rows = React.useMemo(() => buildFleetRows(logs, cwd), [logs, cwd])
+  const logRows = React.useMemo(
+    () => rows.map((row, index) => (row.kind === 'log' ? index : -1)).filter(i => i >= 0),
+    [rows],
+  )
+  const projectCount = rows.filter(row => row.kind === 'group').length
+
+  const [focus, setFocus] = React.useState<number>(logRows[0] ?? -1)
+  const [pendingDeleteKey, setPendingDeleteKey] = React.useState<string | null>(null)
+  const [draft, setDraft] = React.useState('')
+  const [cursor, setCursor] = React.useState(0)
+
+  // A deleted or newly loaded list may leave the focus pointing at nothing.
+  React.useEffect(() => {
+    if (!logRows.includes(focus)) setFocus(logRows[0] ?? -1)
+  }, [logRows, focus])
+
+  const focused = rows[focus]
+  const focusedLog = focused?.kind === 'log' ? focused : undefined
+
+  const moveFocus = React.useCallback(
+    (delta: number) => {
+      if (logRows.length === 0) return
+      const at = Math.max(0, logRows.indexOf(focus))
+      const next = Math.min(logRows.length - 1, Math.max(0, at + delta))
+      setFocus(logRows[next]!)
+      setPendingDeleteKey(null)
+    },
+    [focus, logRows],
+  )
+
+  const openFocused = React.useCallback(() => {
+    if (focusedLog) onSelect(focusedLog.log)
+  }, [focusedLog, onSelect])
+
+  const requestDelete = React.useCallback(() => {
+    if (!onDelete || !focusedLog) return
+    if (pendingDeleteKey === focusedLog.key) {
+      setPendingDeleteKey(null)
+      onDelete(focusedLog.log)
+    } else {
+      setPendingDeleteKey(focusedLog.key)
+    }
+  }, [onDelete, focusedLog, pendingDeleteKey])
+
+  const hasBox = onNewSession !== undefined
+
+  // Keeps the REPL's cancel handler off our Escape while the view is open.
+  useRegisterOverlay('session-fleet')
+  useInput(
+    (input, key) => {
+      if (key.escape) {
+        onCancel()
+        return
+      }
+      if (key.ctrl && input === 'x') {
+        requestDelete()
+        return
+      }
+      // With the text box present, arrows and Enter arrive through it instead.
+      if (hasBox) return
+      if (key.upArrow) moveFocus(-1)
+      else if (key.downArrow) moveFocus(1)
+      else if (key.return) openFocused()
+    },
+    { isActive: !busy },
+  )
+
+  // Layout: pointer+glyph 5, title, detail (flexible), PR, age 6.
+  const anyPr = logs.some(log => log.prNumber !== undefined)
+  const titleWidth = Math.min(32, Math.max(12, Math.floor(columns * 0.3)))
+  const prWidth = anyPr ? 9 : 0
+  const detailWidth = Math.max(8, columns - 5 - titleWidth - prWidth - 6 - 2)
+  const visible = Math.max(4, termRows - (hasBox ? 11 : 9))
+  const start = Math.min(
+    Math.max(0, focus - Math.floor(visible / 2)),
+    Math.max(0, rows.length - visible),
+  )
+  const window = rows.slice(start, start + visible)
+
+  const pendingTitle =
+    pendingDeleteKey && focusedLog && focusedLog.key === pendingDeleteKey
+      ? getLogDisplayTitle(focusedLog.log)
+      : undefined
+
+  return (
+    <Box flexDirection="column">
+      <Box flexDirection="column" marginBottom={1}>
+        <Box flexDirection="row" gap={2}>
+          <WordmarkRow />
+          <Text dimColor>v{version}</Text>
+        </Box>
+        <Text>
+          <Text dimColor>New sessions: </Text>
+          {model ?? '—'}
+          <Text dimColor> · </Text>
+          {shortenHome(cwd)}
+        </Text>
+        <Text dimColor>
+          {logs.length} {logs.length === 1 ? 'session' : 'sessions'} · {projectCount}{' '}
+          {projectCount === 1 ? 'project' : 'projects'}
+        </Text>
+      </Box>
+
+      {rows.length === 0 ? (
+        <Text dimColor>No saved sessions yet.</Text>
+      ) : (
+        <Box flexDirection="column">
+          {start > 0 ? <Text dimColor>  ↑ {start} more</Text> : null}
+          {window.map((row, offset) => {
+            const index = start + offset
+            if (row.kind === 'group') {
+              return (
+                <Box key={`group:${row.label}`} marginTop={offset === 0 ? 0 : 1}>
+                  <Text bold={row.isCurrent} dimColor={!row.isCurrent}>
+                    {row.label}
+                  </Text>
+                </Box>
+              )
+            }
+            const isFocused = index === focus
+            const isPendingDelete = pendingDeleteKey === row.key
+            const title = getLogDisplayTitle(row.log)
+            const color = isPendingDelete ? 'error' : isFocused ? 'suggestion' : undefined
+            return (
+              <Box key={row.key} flexDirection="row">
+                <Box width={5}>
+                  <Text color={color}>{isFocused ? ' ❯ ' : '   '}</Text>
+                  <Text color="success">• </Text>
+                </Box>
+                <Box width={titleWidth}>
+                  <Text bold={isFocused} color={color}>
+                    {truncateToWidth(title, titleWidth - 1)}
+                  </Text>
+                </Box>
+                <Box width={detailWidth}>
+                  <Text dimColor>{truncateToWidth(detailOf(row.log, title), detailWidth - 1)}</Text>
+                </Box>
+                {prWidth > 0 ? (
+                  <Box width={prWidth} justifyContent="flex-end">
+                    <Text dimColor>{row.log.prNumber !== undefined ? `PR #${row.log.prNumber}` : ''}</Text>
+                  </Box>
+                ) : null}
+                <Box width={6} justifyContent="flex-end">
+                  <Text dimColor>{ageLabel(row.log.modified)}</Text>
+                </Box>
+              </Box>
+            )
+          })}
+          {start + visible < rows.length ? (
+            <Text dimColor>  ↓ {rows.length - start - visible} more</Text>
+          ) : null}
+        </Box>
+      )}
+
+      {hasBox ? (
+        <Box flexDirection="column" marginTop={1}>
+          <Text dimColor>{'─'.repeat(Math.max(10, columns - 2))}</Text>
+          <Box flexDirection="row" gap={1}>
+            <Text color="suggestion">❯</Text>
+            <TextInput
+              value={draft}
+              onChange={setDraft}
+              cursorOffset={cursor}
+              onChangeCursorOffset={setCursor}
+              columns={Math.max(20, columns - 6)}
+              placeholder="describe a task for a new session"
+              onHistoryUp={() => moveFocus(-1)}
+              onHistoryDown={() => moveFocus(1)}
+              onSubmit={value => {
+                const prompt = value.trim()
+                if (prompt) onNewSession?.(prompt)
+                else openFocused()
+              }}
+            />
+          </Box>
+          <Text dimColor>{'─'.repeat(Math.max(10, columns - 2))}</Text>
+        </Box>
+      ) : null}
+
+      <Box marginTop={hasBox ? 0 : 1} flexDirection="column">
+        {notice ? <Text color="error">{notice}</Text> : null}
+        {pendingTitle ? (
+          <Text color="warning">Press ctrl+x again to delete “{truncateToWidth(pendingTitle, 40)}”.</Text>
+        ) : null}
+        {busy ? (
+          <Box>
+            <Spinner />
+            <Text> Opening…</Text>
+          </Box>
+        ) : (
+          <Text dimColor>
+            {' '}enter to open · ↑↓ to move
+            {onDelete ? ' · ctrl+x to delete' : ''}
+            {hasBox ? ' · type a task to start a new session here' : ''} · esc to {hasBox ? 'quit' : 'close'}
+          </Text>
+        )}
+      </Box>
+    </Box>
+  )
+}
